# ==========================================
# LeadPilot AI - .gitignore
# Protecting confidential & sensitive data
# ==========================================

# Environment variables & secrets (CONFIDENTIAL)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx
*.p12
secrets/
credentials.json
service_account*.json
token.json
oauth_credentials.json

# Databases & local persistent state (CONFIDENTIAL / PII)
*.db
*.sqlite
*.sqlite3
data/
storage/

# Audio recordings & transcripts (CONFIDENTIAL / PII)
recordings/
transcripts/
audio_cache/
*.wav
*.mp3
*.ogg
*.m4a
*.flac

# Logs & diagnostic dumps
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js
frontend/dist/
frontend/build/
.next/
.nuxt/
.cache/

# Editor & OS Metadata
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary files
doc_dump.txt
tmp/
temp/
scratch/
