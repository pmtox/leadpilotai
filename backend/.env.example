# ==========================================
# LeadPilot AI - Backend Environment Config
# ==========================================

# Application Settings
APP_NAME=LeadPilot AI
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Settings (frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite for MVP)
DATABASE_URL=sqlite:///./leadpilot.db

# LLM Providers (Configure at least one)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
# Optional extraction calls default off; local rules handle lead qualification.
LLM_EXTRACTION_ENABLED=false
# Caps apply per running backend process; configure provider-side quotas for hard billing limits.
LLM_MAX_CALLS_PER_CONVERSATION=2
LLM_MAX_CALLS_PER_DAY=100

# Meta WhatsApp Cloud API (Optional - pending access)
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_GRAPH_API_VERSION=v26.0

# Automatic email recap delivery after calls (requires SMTP configuration)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
